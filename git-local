#!/bin/sh
# Use local Git metadata because the environment reserves a read-only .git.
project_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit
if [ ! -d "$project_dir/.git-local" ]; then
    exec git -C "$project_dir" "$@"
fi
exec git --git-dir="$project_dir/.git-local" --work-tree="$project_dir" "$@"
